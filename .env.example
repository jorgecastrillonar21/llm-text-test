# Copy to .env and adjust. Never commit .env.
# The backend reads this file from the repository root.

APP_ENV=development
LOG_LEVEL=INFO

# SQLite (async). Relative paths resolve against the repository root.
# Leave empty to use the default: data/ooc.db
DATABASE_URL=

# ---------------------------------------------------------------------------
# Story provider: mock | ollama
# `mock` is deterministic and requires no AI runtime. Start here.
# ---------------------------------------------------------------------------
STORY_PROVIDER=mock

OLLAMA_BASE_URL=http://127.0.0.1:11434
# Required only when STORY_PROVIDER=ollama. e.g. llama3.1:8b, qwen2.5:7b, mistral-nemo
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_TEMPERATURE=0.7
# Context window in tokens -- how much the model may read. Ollama's own default is
# 4096 regardless of the model, and it drops the head of an oversized prompt -- the
# rules, world and characters -- without any error. A full context measures ~6.7k
# tokens, so do not lower this below 8192 unless you also lower the retrieval limits.
# Raising it costs VRAM, and on a machine where that pushes layers onto the CPU it
# costs throughput too. See docs/llm-performance-baseline.md.
OLLAMA_NUM_CTX=8192

# How long Ollama keeps the model resident after a request, e.g. 5m, 30m, or -1 for
# "until something evicts it". Empty sends nothing and lets Ollama use its own default
# (5 minutes at the time of writing). A cold model costs seconds of load time before
# the first token; watch `load_ms` in the metrics to see whether you are paying it.
# -1 is a standing memory commitment, not a free speedup.
OLLAMA_KEEP_ALIVE=

# ---------------------------------------------------------------------------
# Output budgets and performance instrumentation.
# Budgets are in TOKENS, not characters -- roughly 3-4 characters each in English.
# ---------------------------------------------------------------------------
# Ceiling on a story turn's generated tokens (Ollama `num_predict`). A turn is a
# schema-constrained JSON document, so a budget that runs out mid-document produces
# invalid JSON and a failed turn rather than a shorter one. Lower it only with the
# baseline in front of you: docs/llm-performance-baseline.md.
STORY_MAX_OUTPUT_TOKENS=1024
# Ceiling for the standalone narration call, which is one paragraph of prose and can
# safely be cut short.
NARRATION_MAX_OUTPUT_TOKENS=320

# Above this, a generation is logged at WARNING as slow. Diagnostic only -- nothing in
# the game behaves differently and a slow call is still a completed call.
LLM_SLOW_CALL_THRESHOLD_MS=30000
# How many recent generation records /api/v1/dev/llm/performance keeps in memory.
LLM_METRICS_BUFFER_SIZE=200
# Stream the Ollama response instead of waiting for the whole document. Off by default:
# the only thing it buys today is `time_to_first_token_ms`, because schema-constrained
# JSON cannot be usefully displayed half-decoded.
OLLAMA_STREAMING_ENABLED=false

# ---------------------------------------------------------------------------
# Image provider: disabled | mock | comfyui
# The core game loop does not need images. `disabled` is the default.
# ---------------------------------------------------------------------------
IMAGE_PROVIDER=disabled

COMFYUI_BASE_URL=http://127.0.0.1:8188
# Path to an API-format workflow JSON. See ai/comfyui/README.md.
COMFYUI_WORKFLOW_PATH=
COMFYUI_TIMEOUT_SECONDS=120

# Comma-separated browser origins allowed to call the API.
# For LAN/phone access add your PC's LAN origin, e.g. http://192.168.1.50:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
